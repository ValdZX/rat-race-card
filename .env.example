MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=Cluster0
MONGODB_DATABASE=board
ALLOWED_ORIGINS=

# Board generation. Configure at least one provider API key.
LLM_PROVIDER_NAME=gemini
LLM_API_KEY=
LLM_API_URL=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
LLM_BALANCE_MODEL=gemini-3.6-flash
LLM_TEXT_MODEL=gemini-3.5-flash-lite
# Extra chat/completions fields, merged into the request body as raw JSON.
# Card texts need no reasoning, so the text model is asked for the cheapest setting the provider allows.
# Check what your model accepts: reasoning_effort and thinking_budget/thinking_level cannot be combined,
# and Gemini 2.5 and 3.x spell it differently. If the provider rejects the fields, the server logs a
# warning, repeats the request without them and stops sending them for the rest of the run.
# LLM_TEXT_EXTRA={"reasoning_effort":"low"}
# LLM_BALANCE_EXTRA=

# Free-tier providers. URL and model overrides are optional; built-in defaults are shown below.
GROQ_API_KEY=
# GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions
# GROQ_BALANCE_MODEL=openai/gpt-oss-120b
# GROQ_TEXT_MODEL=qwen/qwen3.6-27b
# GROQ_TEXT_EXTRA={"reasoning_effort":"none"}

CEREBRAS_API_KEY=
# CEREBRAS_API_URL=https://api.cerebras.ai/v1/chat/completions
# CEREBRAS_MODEL=gpt-oss-120b

NVIDIA_API_KEY=
# NVIDIA_API_URL=https://integrate.api.nvidia.com/v1/chat/completions
# NVIDIA_BALANCE_MODEL=meta/llama-3.3-70b-instruct
# NVIDIA_TEXT_MODEL=meta/llama-3.3-70b-instruct
# Nemotron models reason by default and answer with <think> blocks that eat the completion budget.
# NVIDIA switches reasoning off through a /no_think line in the system prompt, which cannot be set from
# here, so pick a non-reasoning text model instead of nvidia/llama-3.3-nemotron-super-49b-v1.5.

MISTRAL_API_KEY=
# MISTRAL_API_URL=https://api.mistral.ai/v1/chat/completions
# MISTRAL_REVIEW_MODEL=mistral-small-2603
# MISTRAL_REVIEW_EXTRA={"temperature":0,"response_format":{"type":"json_object"}}

OPENROUTER_API_KEY=
# OPENROUTER_API_URL=https://openrouter.ai/api/v1/chat/completions
# OPENROUTER_BALANCE_MODEL=nvidia/nemotron-3-super-120b-a12b:free
# OPENROUTER_TEXT_MODEL=google/gemma-4-31b-it:free
# OPENROUTER_BALANCE_EXTRA={"reasoning":{"enabled":false},"response_format":{"type":"json_object"}}
# OPENROUTER_TEXT_EXTRA={"reasoning":{"enabled":false}}

# Gemini is preferred. Free-tier providers serve concurrent work or act as fallbacks when an earlier provider
# is busy, unavailable, or rate limited. OpenRouter is fallback-only and does not serve concurrent overflow.
# Mistral reviews generated uk/en batches and is not used for generation.
# A provider that answers 429 is put on cooldown and skipped until its limit resets.
# A provider whose API_KEY is set but URL or model is missing is ignored with a warning on startup.
# Every provider accepts its own <PREFIX>_TEXT_EXTRA and <PREFIX>_BALANCE_EXTRA, for example GROQ_TEXT_EXTRA.
# Generic slots remain available for any other OpenAI-compatible provider or local model.
# LLM_FALLBACK_1_PROVIDER_NAME=ollama
# LLM_FALLBACK_1_API_KEY=
# LLM_FALLBACK_1_API_URL=http://localhost:11434/v1/chat/completions
# LLM_FALLBACK_1_MODEL=qwen3:30b
