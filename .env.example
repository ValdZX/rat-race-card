MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=Cluster0
MONGODB_DATABASE=board
ALLOWED_ORIGINS=

# Card text generation. Without LLM_API_KEY the server falls back to template texts.
# Any OpenAI-compatible chat-completions endpoint works: Groq, OpenRouter, Mistral, a local Ollama.
LLM_API_KEY=
LLM_API_URL=https://api.groq.com/openai/v1/chat/completions
LLM_MODEL=llama-3.3-70b-versatile
