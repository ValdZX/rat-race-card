MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=Cluster0
MONGODB_DATABASE=board
ALLOWED_ORIGINS=

# Board generation. Without LLM_API_KEY the server cannot create a board.
# Any OpenAI-compatible chat-completions endpoint works: Groq, OpenRouter, Mistral, a local Ollama.
LLM_PROVIDER_NAME=gemini
LLM_API_KEY=
LLM_API_URL=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
LLM_BALANCE_MODEL=gemini-3.6-flash
LLM_TEXT_MODEL=gemini-3.5-flash-lite

# Optional providers are tried in order whenever the previous one is unavailable or rate-limited.
# LLM_FALLBACK_1_PROVIDER_NAME=groq
# LLM_FALLBACK_1_API_KEY=
# LLM_FALLBACK_1_API_URL=https://api.groq.com/openai/v1/chat/completions
# LLM_FALLBACK_1_BALANCE_MODEL=openai/gpt-oss-120b
# LLM_FALLBACK_1_TEXT_MODEL=openai/gpt-oss-20b
# LLM_FALLBACK_2_PROVIDER_NAME=ollama
# LLM_FALLBACK_2_API_KEY=ollama
# LLM_FALLBACK_2_API_URL=http://localhost:11434/v1/chat/completions
# LLM_FALLBACK_2_BALANCE_MODEL=qwen3:30b
# LLM_FALLBACK_2_TEXT_MODEL=qwen3:30b
